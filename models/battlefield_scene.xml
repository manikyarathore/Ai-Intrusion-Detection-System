<mujoco model="UAV-IDS Battlefield Scene (Skydio X2 x2 + static scenery)">
  <!-- Two independently-actuated clones of the MuJoCo Menagerie Skydio X2, over a large
       grass battlefield split by a border into two territories:
         x < 0  = "friendly" territory (main drone patrols here)
         x > 0  = "enemy" territory (attacker drone stations here)
       2 static tanks sit in enemy territory, 1 static car in friendly territory -- all
       welded to the world (no joint => immovable), per the "static only" requirement. -->

  <compiler autolimits="true" assetdir="assets"/>
  <option timestep="0.01" density="1.225" viscosity="1.8e-5"/>

  <default>
    <default class="x2">
      <geom mass="0"/>
      <motor ctrlrange="0 13"/>
      <mesh scale="0.01 0.01 0.01"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="box"/>
        <default class="rotor">
          <geom type="ellipsoid" size=".13 .13 .01"/>
        </default>
      </default>
      <site group="5"/>
    </default>
    <default class="scenery">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="tree">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
  </default>

  <asset>
    <texture type="2d" file="X2_lowpoly_texture_SpinningProps_1024.png"/>
    <material name="phong3SG" texture="X2_lowpoly_texture_SpinningProps_1024"/>
    <material name="invisible" rgba="0 0 0 0"/>
    <mesh class="x2" file="X2_lowpoly.obj"/>

    <texture type="skybox" builtin="gradient" rgb1="0.45 0.6 0.75" rgb2="0.05 0.05 0.1" width="512" height="3072"/>

    <!-- grass battlefield ground -->
    <texture type="2d" name="grass" builtin="checker" mark="none" rgb1="0.16 0.32 0.12" rgb2="0.20 0.38 0.15"
      width="300" height="300"/>
    <material name="grass" texture="grass" texuniform="true" texrepeat="40 40" reflectance="0.05" shininess="0.02"/>

    <!-- no-man's-land dirt stripe along the border -->
    <texture type="2d" name="dirt" builtin="flat" rgb1="0.42 0.33 0.22" width="64" height="64"/>
    <material name="dirt" texture="dirt" texuniform="true" texrepeat="6 40" reflectance="0.02"/>

    <material name="concrete" rgba="0.55 0.55 0.53 1"/>
    <material name="olive" rgba="0.30 0.33 0.20 1"/>
    <material name="olive_dark" rgba="0.20 0.22 0.14 1"/>
    <material name="gunmetal" rgba="0.12 0.12 0.13 1"/>
    <material name="car_body" rgba="0.55 0.12 0.10 1"/>
    <material name="car_glass" rgba="0.15 0.20 0.25 0.8"/>
    <material name="tire" rgba="0.05 0.05 0.05 1"/>
    <material name="tree_trunk" rgba="0.32 0.20 0.10 1"/>
    <material name="tree_leaves" rgba="0.10 0.28 0.09 1"/>
    <material name="tree_leaves2" rgba="0.13 0.33 0.11 1"/>
  </asset>

  <visual>
    <headlight diffuse="0.7 0.7 0.65" ambient="0.35 0.35 0.32" specular="0.1 0.1 0.1"/>
    <rgba haze="0.35 0.42 0.35 1"/>
    <global azimuth="-35" elevation="-25" ellipsoidinertia="true" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <worldbody>
    <light pos="-10 -10 15" dir="0.5 0.5 -1" directional="true" diffuse="0.7 0.7 0.65"/>
    <light pos="10 10 15" dir="-0.5 -0.5 -1" directional="true" diffuse="0.4 0.4 0.4"/>

    <!-- large grass battlefield, 60m x 60m -->
    <geom name="floor" size="30 30 0.05" type="plane" material="grass"/>
    <!-- no-man's-land stripe marking the border, x in [-2,2] -->
    <geom name="border_stripe" type="box" size="2 25 0.001" pos="0 0 0.002" material="dirt"
          contype="0" conaffinity="0"/>
    <!-- the border line itself: a low concrete wall, welded to the world (static) -->
    <geom name="border_wall" class="scenery" type="box" size="0.25 25 0.55" pos="0 0 0.55" material="concrete"/>
    <!-- short wall posts for visual detail -->
    <geom name="border_post_1" class="scenery" type="box" size="0.35 0.35 0.75" pos="0 -12 0.75" material="concrete"/>
    <geom name="border_post_2" class="scenery" type="box" size="0.35 0.35 0.75" pos="0 0 0.75" material="concrete"/>
    <geom name="border_post_3" class="scenery" type="box" size="0.35 0.35 0.75" pos="0 12 0.75" material="concrete"/>

    <!-- ============ STATIC SCENERY: 2 tanks in enemy territory (x>0) ============ -->
    <body name="tank_1" pos="9 -9 0">
      <geom class="scenery" type="box" size=".65 1.3 .40" pos="0 0 .40" material="olive"/>
      <geom class="scenery" type="box" size=".45 .5 .28" pos="0 .1 .95" material="olive_dark"/>
      <geom class="scenery" type="cylinder" size=".07 .75" pos="0 1.15 1.0" quat="0.7071 0.7071 0 0" material="gunmetal"/>
      <geom class="scenery" type="box" size=".68 1.35 .12" pos="-.68 0 .12" material="gunmetal"/>
      <geom class="scenery" type="box" size=".68 1.35 .12" pos=".68 0 .12" material="gunmetal"/>
    </body>

    <body name="tank_2" pos="14 11 0" quat="0.92388 0 0 0.38268">
      <geom class="scenery" type="box" size=".65 1.3 .40" pos="0 0 .40" material="olive"/>
      <geom class="scenery" type="box" size=".45 .5 .28" pos="0 -.1 .95" material="olive_dark"/>
      <geom class="scenery" type="cylinder" size=".07 .75" pos="0 -1.15 1.0" quat="0.7071 0.7071 0 0" material="gunmetal"/>
      <geom class="scenery" type="box" size=".68 1.35 .12" pos="-.68 0 .12" material="gunmetal"/>
      <geom class="scenery" type="box" size=".68 1.35 .12" pos=".68 0 .12" material="gunmetal"/>
    </body>

    <!-- ============ STATIC SCENERY: 1 car in friendly territory (x<0) ============ -->
    <body name="car_1" pos="-10 -6 0" quat="0.8660 0 0 0.5">
      <geom class="scenery" type="box" size=".95 .42 .28" pos="0 0 .43" material="car_body"/>
      <geom class="scenery" type="box" size=".55 .38 .22" pos="-.05 0 .78" material="car_glass"/>
      <geom class="scenery" type="cylinder" size=".18 .10" pos=".62 .42 .18" quat="0.7071 0.7071 0 0" material="tire"/>
      <geom class="scenery" type="cylinder" size=".18 .10" pos=".62 -.42 .18" quat="0.7071 0.7071 0 0" material="tire"/>
      <geom class="scenery" type="cylinder" size=".18 .10" pos="-.62 .42 .18" quat="0.7071 0.7071 0 0" material="tire"/>
      <geom class="scenery" type="cylinder" size=".18 .10" pos="-.62 -.42 .18" quat="0.7071 0.7071 0 0" material="tire"/>
    </body>


    <!-- ============ STATIC SCENERY: trees ============ -->
    <body name="tree_1" pos="7.25 -22.8 0">
      <geom class="tree" type="cylinder" size="0.14 1.08" pos="0 0 1.08" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="1.02" pos="0 0 2.77" material="tree_leaves"/>
    </body>
    <body name="tree_2" pos="-11.7 -13.29 0">
      <geom class="tree" type="cylinder" size="0.14 1.05" pos="0 0 1.05" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.99" pos="0 0 2.69" material="tree_leaves2"/>
    </body>
    <body name="tree_3" pos="12.3 8.48 0">
      <geom class="tree" type="cylinder" size="0.13 0.96" pos="0 0 0.96" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.91" pos="0 0 2.47" material="tree_leaves"/>
    </body>
    <body name="tree_4" pos="20.39 -19.83 0">
      <geom class="tree" type="cylinder" size="0.15 1.16" pos="0 0 1.16" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="1.09" pos="0 0 2.97" material="tree_leaves2"/>
    </body>
    <body name="tree_5" pos="-4.06 -22.57 0">
      <geom class="tree" type="cylinder" size="0.12 0.89" pos="0 0 0.89" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.84" pos="0 0 2.28" material="tree_leaves"/>
    </body>
    <body name="tree_6" pos="-14.63 0.26 0">
      <geom class="tree" type="cylinder" size="0.13 0.97" pos="0 0 0.97" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.91" pos="0 0 2.49" material="tree_leaves2"/>
    </body>
    <body name="tree_7" pos="-24.62 -14.46 0">
      <geom class="tree" type="cylinder" size="0.15 1.09" pos="0 0 1.09" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="1.03" pos="0 0 2.8" material="tree_leaves"/>
    </body>
    <body name="tree_8" pos="7.79 2.16 0">
      <geom class="tree" type="cylinder" size="0.13 1.0" pos="0 0 1.0" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.94" pos="0 0 2.56" material="tree_leaves2"/>
    </body>
    <body name="tree_9" pos="-14.54 4.28 0">
      <geom class="tree" type="cylinder" size="0.15 1.11" pos="0 0 1.11" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="1.05" pos="0 0 2.85" material="tree_leaves"/>
    </body>
    <body name="tree_10" pos="16.09 -23.69 0">
      <geom class="tree" type="cylinder" size="0.13 0.98" pos="0 0 0.98" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.93" pos="0 0 2.52" material="tree_leaves2"/>
    </body>
    <body name="tree_11" pos="-8.31 -16.54 0">
      <geom class="tree" type="cylinder" size="0.14 1.04" pos="0 0 1.04" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.98" pos="0 0 2.67" material="tree_leaves"/>
    </body>
    <body name="tree_12" pos="23.78 -7.84 0">
      <geom class="tree" type="cylinder" size="0.1 0.74" pos="0 0 0.74" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.7" pos="0 0 1.9" material="tree_leaves2"/>
    </body>
    <body name="tree_13" pos="-21.18 -19.36 0">
      <geom class="tree" type="cylinder" size="0.11 0.82" pos="0 0 0.82" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.78" pos="0 0 2.11" material="tree_leaves"/>
    </body>
    <body name="tree_14" pos="18.07 4.98 0">
      <geom class="tree" type="cylinder" size="0.11 0.85" pos="0 0 0.85" material="tree_trunk"/>
      <geom class="tree" type="sphere" size="0.8" pos="0 0 2.18" material="tree_leaves2"/>
    </body>
    <!-- ================= MAIN DRONE (friendly, patrols x<0) ================= -->
    <body name="main" pos="-6 -16 3.0" childclass="x2">
      <freejoint/>
      <camera name="main_track" pos="-1 0 .5" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <site name="main_imu" pos="0 0 .02"/>
      <site name="main_gnss" pos="0 0 .03"/>
      <geom material="phong3SG" mesh="X2_lowpoly" class="visual" quat="0 0 1 1"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .02"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .06"/>
      <geom class="collision" size=".05 .027 .02" pos="-.07 0 .065"/>
      <geom class="collision" size=".023 .017 .01" pos="-.137 .008 .065" quat="1 0 0 1"/>
      <geom name="main_rotor1" class="rotor" pos="-.14 -.18 .05" mass=".25"/>
      <geom name="main_rotor2" class="rotor" pos="-.14 .18 .05" mass=".25"/>
      <geom name="main_rotor3" class="rotor" pos=".14 .18 .08" mass=".25"/>
      <geom name="main_rotor4" class="rotor" pos=".14 -.18 .08" mass=".25"/>
      <geom size=".16 .04 .02" pos="0 0 0.02" type="ellipsoid" mass=".325" class="visual" material="invisible"/>
      <site name="main_thrust1" pos="-.14 -.18 .05"/>
      <site name="main_thrust2" pos="-.14 .18 .05"/>
      <site name="main_thrust3" pos=".14 .18 .08"/>
      <site name="main_thrust4" pos=".14 -.18 .08"/>
    </body>

    <!-- ================= ATTACKER DRONE (enemy, stations x>0) ================= -->
    <body name="att" pos="8 0 3.0" childclass="x2">
      <freejoint/>
      <camera name="att_track" pos="-1 0 .5" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <site name="att_imu" pos="0 0 .02"/>
      <site name="att_gnss" pos="0 0 .03"/>
      <geom material="phong3SG" mesh="X2_lowpoly" class="visual" quat="0 0 1 1" rgba="1 0.35 0.35 1"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .02"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .06"/>
      <geom class="collision" size=".05 .027 .02" pos="-.07 0 .065"/>
      <geom class="collision" size=".023 .017 .01" pos="-.137 .008 .065" quat="1 0 0 1"/>
      <geom name="att_rotor1" class="rotor" pos="-.14 -.18 .05" mass=".25"/>
      <geom name="att_rotor2" class="rotor" pos="-.14 .18 .05" mass=".25"/>
      <geom name="att_rotor3" class="rotor" pos=".14 .18 .08" mass=".25"/>
      <geom name="att_rotor4" class="rotor" pos=".14 -.18 .08" mass=".25"/>
      <geom size=".16 .04 .02" pos="0 0 0.02" type="ellipsoid" mass=".325" class="visual" material="invisible"/>
      <site name="att_thrust1" pos="-.14 -.18 .05"/>
      <site name="att_thrust2" pos="-.14 .18 .05"/>
      <site name="att_thrust3" pos=".14 .18 .08"/>
      <site name="att_thrust4" pos=".14 -.18 .08"/>
    </body>
  </worldbody>

  <actuator>
    <!-- main drone motors -->
    <motor class="x2" name="main_thrust1" site="main_thrust1" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="main_thrust2" site="main_thrust2" gear="0 0 1 0 0 .0201"/>
    <motor class="x2" name="main_thrust3" site="main_thrust3" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="main_thrust4" site="main_thrust4" gear="0 0 1 0 0 .0201"/>
    <!-- attacker drone motors -->
    <motor class="x2" name="att_thrust1" site="att_thrust1" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="att_thrust2" site="att_thrust2" gear="0 0 1 0 0 .0201"/>
    <motor class="x2" name="att_thrust3" site="att_thrust3" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="att_thrust4" site="att_thrust4" gear="0 0 1 0 0 .0201"/>
  </actuator>

  <sensor>
    <!-- === MAIN DRONE: exactly the sensors the 4 attacks + PRHN detector need === -->
    <gyro name="main_gyro" site="main_imu"/>
    <accelerometer name="main_accel" site="main_imu"/>
    <magnetometer name="main_mag" site="main_imu"/>
    <framepos name="main_gps_pos" objtype="site" objname="main_gnss"/>
    <framequat name="main_att_quat" objtype="site" objname="main_imu"/>
    <actuatorfrc name="main_frc1" actuator="main_thrust1"/>
    <actuatorfrc name="main_frc2" actuator="main_thrust2"/>
    <actuatorfrc name="main_frc3" actuator="main_thrust3"/>
    <actuatorfrc name="main_frc4" actuator="main_thrust4"/>

    <!-- === ATTACKER DRONE: range/bearing to the main drone === -->
    <framepos name="att_gps_pos" objtype="site" objname="att_gnss"/>
    <framequat name="att_att_quat" objtype="site" objname="att_imu"/>
  </sensor>

  <keyframe>
    <key name="hover" qpos="-6 -16 3.0 1 0 0 0  8 0 3.0 1 0 0 0"
         ctrl="3.2495625 3.2495625 3.2495625 3.2495625  3.2495625 3.2495625 3.2495625 3.2495625"/>
  </keyframe>
</mujoco>
